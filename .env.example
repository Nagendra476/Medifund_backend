# ─── Django Core ──────────────────────────────────────────────────────────────
SECRET_KEY=
DEBUG=False

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Get this from: Supabase → Project Settings → Database → Connection String (URI)
# Use the "Transaction" pooler URL for Render (port 6543) to avoid connection limits
DATABASE_URL=

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── CORS & Hosts ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed hosts (your Render backend URL)
ALLOWED_HOSTS=
# Comma-separated list of allowed CORS origins (your React frontend URL)
CORS_ALLOWED_ORIGINS=

# ─── Cloudinary (Media / File Uploads) ────────────────────────────────────────
# Required for production file uploads on Render (ephemeral filesystem)
# Get from: cloudinary.com → Dashboard → API Keys
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
